<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 电脑上的服务是 http（Tailscale 内网），需要允许明文。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
